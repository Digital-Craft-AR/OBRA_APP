# Client (Vite) — anon key only; safe to expose in the browser bundle
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: log structured auth checkpoints to the browser console (no PII). Use for short prod debugging.
# VITE_AUTH_EMAIL_INSTRUMENTATION=true

# Seed script / server-side automation only — NEVER prefix with VITE_ or import in client code
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Strong secret; do not commit. Optional: TEST_USER_PASSWORD_1, _2, _3 for per-user overrides
TEST_USER_PASSWORD=
