# Supabase Edge Functions secrets (do NOT commit real values)

# Required by webhook + checkout functions
# IMPORTANT (`supabase functions serve`): use the SAME project URL + keys as the Vite app
# (obra/.env → VITE_SUPABASE_*). If SUPABASE_URL is the local stack (127.0.0.1) while the app
# talks to your hosted project, functions query an empty local DB and you get errors like
# chapter_not_found (detail: no_row).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional — `generate-document-template`: direct Postgres URI for session-level advisory locks
# (prevents two concurrent generations for the same ebook). Use Dashboard → Database → "Direct connection"
# (port 5432), not the transaction pooler (port 6543). Local CLI default:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_DB_URL=
# DATABASE_URL=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=TEST-XXXXXXXXXXXX
MERCADOPAGO_WEBHOOK_SECRET=YOUR_MP_WEBHOOK_SECRET

# Public app URL used for back_url (no trailing slash)
OBRA_APP_URL=https://obra-app-nu.vercel.app

# AI — text (Claude)
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXX
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_REQUEST_TIMEOUT_MS=120000

# AI — images (Gemini native image generation; see https://ai.google.dev/gemini-api/docs/image-generation)
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
IMAGE_GENERATE_CREDIT_COST=3

# PDF export (Puppeteer)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Recurring subscription defaults (Checkout API / preapproval)
MERCADOPAGO_SUBSCRIPTION_REASON=Obra recurring subscription
MERCADOPAGO_SUBSCRIPTION_AMOUNT=100
MERCADOPAGO_SUBSCRIPTION_CURRENCY_ID=ARS
MERCADOPAGO_SUBSCRIPTION_FREQUENCY=1
MERCADOPAGO_SUBSCRIPTION_FREQUENCY_TYPE=months

# Legacy fallback names still supported by code
MERCADOPAGO_CHECKOUT_UNIT_PRICE=100
MERCADOPAGO_CHECKOUT_CURRENCY_ID=ARS
