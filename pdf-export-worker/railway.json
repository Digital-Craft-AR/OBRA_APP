{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "buildCommand": "npm ci"
  },
  "deploy": {
    "startCommand": "node index.js",
    "healthchecks": {
      "readiness": {
        "path": "/health"
      }
    }
  },
  "environmentVariables": {
    "PORT": "3000",
    "NODE_ENV": "production",
    "LOG_LEVEL": "info"
  }
}
