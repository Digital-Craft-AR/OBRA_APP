# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc... # Secret: use service role key for database access

# Storage Configuration
PROJECT_PDFS_BUCKET=project-pdfs

# Puppeteer Configuration
PUPPETEER_TIMEOUT_MS=55000
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Cron Security
CRON_SECRET=your-secret-token # Used to verify cron requests

# Environment
RAILWAY_ENV=production
LOG_LEVEL=info

# Optional: Sentry for error tracking
# SENTRY_DSN=https://... (optional, for production monitoring)
