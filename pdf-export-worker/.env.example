# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these values from Supabase Dashboard: Settings → API

# Your Supabase project URL
# Found at: https://app.supabase.com → Project → Settings → API
# Example: https://xyzabc123.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Service Role Key (SECRET - Never expose publicly)
# Found at: https://app.supabase.com → Project → Settings → API → Service role key
# This key bypasses RLS and allows the worker to access all tables
# IMPORTANT: Keep this secret! Use Railway "Secret" variable type
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon Key (Optional - for read-only public data)
# Found at: https://app.supabase.com → Project → Settings → API → Anon public key
# Only needed if you want to fetch public data without RLS bypass
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# Storage bucket name for uploading PDFs
# Must be created in Supabase Storage with proper RLS policies
# See: https://app.supabase.com → Storage → Buckets
PROJECT_PDFS_BUCKET=project-pdfs

# ============================================================================
# PUPPETEER CONFIGURATION
# ============================================================================

# Timeout for PDF rendering (milliseconds)
# Max 55000 (55 seconds) for Railway compatibility
# Increase if you have very large PDFs (100+ pages)
PUPPETEER_TIMEOUT_MS=55000

# Path to Chromium executable in Docker container
# In Railway/Docker: /usr/bin/chromium (installed via Dockerfile)
# In local Docker: /usr/bin/chromium
# Leave as-is unless you customize the Docker image
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ============================================================================
# CRON SECURITY
# ============================================================================

# Secret token to authorize cron requests
# Must match the Authorization header in cron trigger
# Generate: openssl rand -hex 32
# IMPORTANT: Keep this secret! Use Railway "Secret" variable type
CRON_SECRET=your-very-secret-token-change-me

# ============================================================================
# ENVIRONMENT & LOGGING
# ============================================================================

# Node environment (production, development, test)
NODE_ENV=production

# Log level: debug, info, warn, error
# Use 'debug' for development, 'info' for production
LOG_LEVEL=info

# Port for Express server (should be 3000 for Railway)
PORT=3000

# ============================================================================
# OPTIONAL: ERROR TRACKING
# ============================================================================

# Sentry DSN for error tracking (optional)
# Get from: https://sentry.io → Project → Client Keys (DSN)
# Leave blank to disable Sentry
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ============================================================================
# OPTIONAL: RAILWAY SPECIFIC
# ============================================================================

# Railway environment (production, staging, development)
# Set by Railway automatically, but can override
# RAILWAY_ENVIRONMENT=production

# ============================================================================
# NOTES FOR RAILWAY DEPLOYMENT
# ============================================================================
#
# 1. Get Supabase credentials:
#    - Go to https://app.supabase.com → Select your project
#    - Settings → API
#    - Copy SUPABASE_URL and Service role key
#
# 2. In Railway dashboard:
#    - Click "Variables" tab
#    - Add each variable
#    - Mark SUPABASE_SERVICE_ROLE_KEY and CRON_SECRET as "Secret"
#
# 3. Verify setup:
#    - Check logs: railway logs --follow
#    - Test health: curl https://your-app.up.railway.app/health
#    - Test process: curl -X POST https://your-app.up.railway.app/process \
#        -H "Authorization: Bearer YOUR_CRON_SECRET"
#
